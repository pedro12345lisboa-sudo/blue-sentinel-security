# Blue-Sentinel — variáveis de PRODUÇÃO (modelo)
#
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
#
# NUNCA commite .env.prod (está no .gitignore). Senhas/chaves não ficam aqui:
# vivem em ./secrets/* (modo 600) e entram nos containers como Docker secrets
# (gerados por `./scripts/deployment/deploy.sh init`):
#   postgres_password, smtp_password, secret_key, agent_api_key,
#   agent_hmac_secret, cf_dns_api_token (token REAL do Cloudflare:
#   Zone - DNS - Edit, escopo do domínio), backup.age.key, rclone.conf.
#
# Staging: copie este arquivo como .env.staging e rode os scripts com
# ENV_FILE=.env.staging (ambiente separado — ver docs/architecture/infrastructure.md).

# --------------------------- Identidade do deploy ---------------------------
# Projeto Docker (volumes e redes levam esse prefixo).
COMPOSE_PROJECT_NAME=blue-sentinel

# Registro de imagens + tag publicada pelo .github/workflows/release.yml.
# Formato da imagem: <IMAGE_REGISTRY>/blue-sentinel-{caddy,backend,frontend}:<tag>
IMAGE_REGISTRY=ghcr.io/pedro12345lisboa-sudo
# Tag obrigatória — o deploy.sh a grava sozinho. Ex.: v1.4.0
IMAGE_TAG=v0.0.0

# ------------------------------- Domínio/TLS --------------------------------
# Domínio público (o Caddy serve exatamente este nome; precisa de registro A
# apontando para o Cloudflare com proxy ATIVADO).
DOMAIN=exemplo.com
# E-mail da conta ACME (Let's Encrypt) — avisos de renovação caem aqui.
ACME_EMAIL=contato@exemplo.com
# Caddyfile | Caddyfile.direct (direct = depurar sem o proxy do Cloudflare)
CADDY_CONFIG=Caddyfile
TZ=UTC

# ------------------------------- Banco/Redis --------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=blue_sentinel
POSTGRES_USER=sentinel
# POSTGRES_PASSWORD NÃO vai aqui: secrets/postgres_password (load-secrets.sh)
REDIS_IMAGE=redis:7-alpine

# ------------------------------- E-mail (SMTP) ------------------------------
# SMTP transacional para o formulário de contato. Antes de ligar em produção,
# publique SPF/DKIM/DMARC (tabela em docs/architecture/infrastructure.md).
# SMTP_PASSWORD: secrets/smtp_password
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@exemplo.com
SMTP_FROM=noreply@exemplo.com
EMAIL_TO=destinatario@exemplo.com

# ------------------------------ GitHub (stats) -----------------------------
GITHUB_USERNAME=seu-usuario
# Opcional: sobe o rate limit de 60 p/ 5000 req/h. Se vazar, é só rotacionar
# no GitHub (Settings > Developer settings > Personal access tokens).
GITHUB_TOKEN=

# --------------------------- Retenção de dados ------------------------------
# Mensagens de contato são apagadas do banco após N dias (job de limpeza).
CONTACT_RETENTION_DAYS=90

# --------------------------------- Backups ---------------------------------
# Usado por scripts/deployment/backup.sh e restore.sh:
#   rclone remote (secrets/rclone.conf) para o armazenamento externo S3:
RCLONE_REMOTE=blue-sentinel-backups
RCLONE_CONFIG=./secrets/rclone.conf
# Criptografia age: chave privada (escrow fora do servidor!) e destinatários.
AGE_KEY_FILE=./secrets/backup.age.key
AGE_RECIPIENTS_FILE=./secrets/backup-recipients.txt
# Retenção: 7 diários + 4 semanais (o backup de domingo vira o semanal).
BACKUP_LOCAL_DIR=./backups
BACKUP_RETENTION_DAYS=7
BACKUP_RETENTION_WEEKS=4
# Sobrescreve o container temporário usado no teste de restauração mensal.
RESTORE_TEST_IMAGE=postgres:16-alpine
