# Blue-Sentinel - Environment Variables
# Never commit real secrets. Use Docker secrets or secret management in production.

# ============ DATABASE ============
POSTGRES_DB=blue_sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme_default_must_overwrite
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
# Vazio = Redis sem autenticação (padrão do docker-compose)
REDIS_PASSWORD=
# Rate limit (janela deslizante):
# false = fail-open: Redis fora do ar => o limite deixa passar
# true  = fail-closed: Redis fora do ar => as requisições limitadas são bloqueadas
RATE_LIMIT_FAIL_CLOSED=false

# ============ AGENT AUTHENTICATION ============
# Key shared with C++ agents for HMAC signature verification
AGENT_API_KEY=dev-agent-key-must-change-in-production
AGENT_HMAC_SECRET=this-is-a-dev-secret-must-change-prod-min-32-chars

# ============ SERVER ============
API_V1_STR=/api/v1
SECRET_KEY=this-is-a-dev-secret-key-must-change-min-32-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ============ SERVICE PORTS (for internal networking) ============
REDIS_INTERNAL_PORT=6379
POSTGRES_INTERNAL_PORT=5432
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=3000

# ============ PERFORMANCE ============
# Maximum event batch size before backpressure
INGESTION_BATCH_SIZE=1000
# Queue length threshold (events) before returning 429/503
REDIS_QUEUE_MAXLEN=5000

# ============ MONITORING ============
METRICS_EXPORT_PORT=9090

# ============ EMAIL (Contact Form Worker) ============
# Configure one provider. Leave empty to disable email sending.
EMAIL_PROVIDER=console  # console, sendgrid, resend, smtp
SENDGRID_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@blue-sentinel.local
EMAIL_TO=owner@blue-sentinel.local

# ============ GITHUB API (Stats) ============
GITHUB_TOKEN=  # Optional: increases rate limit from 60/hr to 5000/hr
GITHUB_USERNAME=your-github-username

# ============ OBSERVABILITY / ALERTS ============
# Token do endpoint /api/v1/metrics (Prometheus). Vazio = endpoint desativado.
METRICS_TOKEN=
# Webhook de alertas (Discord: URL do webhook; Telegram via bridge que leia "text")
ALERT_WEBHOOK_URL=
# Destinatario dos alertas por e-mail (vazio = sem e-mail de alerta)
ALERT_EMAIL_TO=
# Segundos sem reenviar o mesmo alerta (deduplicacao)
ALERT_DEDUP_SECONDS=300
# Alertas silenciados, separados por virgula (nome ou severidade): DiskHigh,critical
ALERT_SILENCES=
# Intervalo dos auto-checks do backend (segundos)
ALERT_CHECK_INTERVAL=60
# Token compartilhado Alertmanager -> POST /api/v1/alerts/webhook (vazio = fechado)
ALERT_WEBHOOK_TOKEN=
# Link base de runbook anexado a todo alerta
RUNBOOK_URL=https://github.com/pedro12345lisboa-sudo/blue-sentinel-security/blob/main/docs/architecture/runbook.md
# Dominio para checagem de certificado TLS (vazio = desativado)
CERT_CHECK_HOST=
CERT_CHECK_PORT=443
CERT_WARN_DAYS=14


# ============ PRIVACY / RETENTION (LGPD) ============
# Prazos de retencao (dias) - ver docs/security/data-inventory.md
CONTACT_RETENTION_DAYS=90
LAB_SESSION_RETENTION_DAYS=30
# Frequencia da limpeza automatica (horas)
CLEANUP_INTERVAL_HOURS=24


# ============ FRONTEND / SEO ============
# URL canonica publica (canonical, Open Graph, sitemap, RSS e robots)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# API/WS consumidos pelo navegador (vazio = mesmo host, via rewrite do Next)
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
# Dados pessoais exibidos no site. Sao OPCIONAIS: sem valores, o frontend usa
# placeholders ficticios do frontend/messages/*.json. Nunca commite valores reais.
NEXT_PUBLIC_OWNER_NAME=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_SECURITY_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_REPOSITORY_URL=
NEXT_PUBLIC_PHONE=
