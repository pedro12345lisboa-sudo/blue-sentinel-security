# Blue-Sentinel - Environment Variables
# Never commit real secrets. Use Docker secrets or secret management in production.

# ============ DATABASE ============
POSTGRES_DB=blue_sentinel
POSTGRES_USER=sentinel
POSTGRES_PASSWORD=changeme_default_must_overwrite
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============ REDIS ============
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme_default_must_overwrite

# ============ AGENT AUTHENTICATION ============
# Key shared with C++ agents for HMAC signature verification
AGENT_API_KEY=dev-agent-key-must-change-in-production
AGENT_HMAC_SECRET=this-is-a-dev-secret-must-change-prod-min-32-chars

# ============ SERVER ============
API_V1_STR=/api/v1
SECRET_KEY=this-is-a-dev-secret-key-must-change-min-32-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# ============ SERVICE PORTS (for internal networking) ============
REDIS_INTERNAL_PORT=6379
POSTGRES_INTERNAL_PORT=5432
BACKEND_INTERNAL_PORT=8000
FRONTEND_INTERNAL_PORT=3000

# ============ PERFORMANCE ============
# Maximum event batch size before backpressure
INGESTION_BATCH_SIZE=1000
# Queue length threshold (events) before returning 429/503
REDIS_QUEUE_MAXLEN=5000

# ============ MONITORING ============
METRICS_EXPORT_PORT=9090

# ============ EMAIL (Contact Form Worker) ============
# Configure one provider. Leave empty to disable email sending.
EMAIL_PROVIDER=console  # console, sendgrid, resend, smtp
SENDGRID_API_KEY=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@blue-sentinel.local
EMAIL_TO=owner@blue-sentinel.local

# ============ GITHUB API (Stats) ============
GITHUB_TOKEN=  # Optional: increases rate limit from 60/hr to 5000/hr
GITHUB_USERNAME=your-github-username